<%layout("/layouts/plain.ejs")-%>
<% block("head", '<link rel="stylesheet" href="/css/admin-edit-course.css">') %>

  <div class="navbar">
    <h2>Edit Course</h2>
    <button onclick="window.location.href='/admin/dashboard'">Back to Dashboard</button>
  </div>

  <div class="container">
    <h2>Edit Course Details</h2>
    <form id="editCourseForm" action="/admin/courses/<%= course._id %>?_method=PUT" method="POST">
      <label for="title">Course Title</label>
      <input type="text" id="title" name="title" placeholder="Enter course title" value="<%= course.title %>" required>

      <label for="description">Description</label>
      <textarea id="description" name="description" placeholder="Enter course description" required><%= course.description %></textarea>

      <label for="youtubeVideoId">YouTube Video ID</label>
      <input type="text" id="youtubeVideoId" name="youtube_video_id" placeholder="e.g. dQw4w9WgXcQ" value="<%= course.youtube_video_id %>">
      <p class="hint">Leave empty if using a playlist instead.</p>

      <label for="youtubePlaylistId">YouTube Playlist ID</label>
      <input type="text" id="youtubePlaylistId" name="youtube_playlist_id" placeholder="e.g. PL123abcXYZ" value="<%= course.youtube_playlist_id %>">
      <p class="hint">Leave empty if using a single video.</p>

      <label for="videoCount">Number of Videos</label>
      <input type="number" id="videoCount" name="video_count" min="1" value="<%= course.video_count %>">

      <label for="imageUrl">Course Image URL</label>
      <input type="text" id="imageUrl" name="image_url" placeholder="Enter image URL" value="<%= course.image_url %>" required>

      <label for="category">Category</label>
      <select id="category" name="category" required>
        <option value="">-- Select category --</option>
        <% for(let c of categories){ %>
          <option value="<%= c %>" <%= course.category === c ? "selected" : "" %>><%= c %></option>
        <% } %>
      </select>

      <button type="submit" class="submit-btn">Update Course</button>
    </form>
  </div>
