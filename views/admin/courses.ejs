<%layout("/layouts/plain.ejs")-%>
<% block("head", '<link rel="stylesheet" href="/css/admin-courses.css">') %>

<div class="navbar">
  <h2>All Courses</h2>
  <button onclick="window.location.href='/admin/dashboard'">Back to Dashboard</button>
</div>

<div class="container" id="coursesContainer">
  <h2>Manage Courses</h2>
  <% if(courses.length === 0){ %>
    <p>No courses found. Please add courses.</p>
  <% } %>
  <% for(let course of courses){ %>
    <% let isPlaylist = !!(course.youtube_playlist_id && course.youtube_playlist_id.trim() !== ""); %>
    <div class="course-card">
      <img src="<%= course.image_url || 'https://via.placeholder.com/120x80' %>" alt="<%= course.title %>">
      <div class="course-info">
        <h4><%= course.title %></h4>
        <p><%= (course.description || "").substring(0, 60) %>...</p>
        <p>Category: <%= course.category %></p>
        <p class="meta">Type: <%= isPlaylist ? "Playlist" : "Single Video" %> | <%= isPlaylist ? course.video_count + " Videos" : "1 Video" %></p>
      </div>
      <div class="actions">
        <button class="edit" onclick="window.location.href='/admin/courses/<%= course._id %>/edit'">Edit</button>
        <form action="/admin/courses/<%= course._id %>?_method=DELETE" method="POST" data-confirm="Are you sure you want to delete this course?" style="display:inline;">
          <button type="submit" class="delete">Delete</button>
        </form>
      </div>
    </div>
  <% } %>
</div>
